# MyDPA.ai — Required Environment Variables
# Copy this file to ~/.env and fill in every value before running install.sh

# ── Anthropic (Claude) ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...          # from console.anthropic.com

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=...                # from @BotFather on Telegram
TELEGRAM_CHAT_ID=...                  # your personal Telegram user ID (numbers only)
                                      # send /start to @userinfobot to find yours

# ── Notion ───────────────────────────────────────────────────────────────────
NOTION_TOKEN=secret_...               # from notion.so/my-integrations

# ── OpenAI (voice transcription) ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...                 # from platform.openai.com — needed for voice messages

# ── Gmail (optional — needed only if you want Nova to send email) ─────────────
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REFRESH_TOKEN=...              # see setup/SETUP.md §Gmail for OAuth steps
